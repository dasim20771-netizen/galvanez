# Resend API key from your Resend dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Verified sender, e.g. Motion+ <noreply@yourdomain.com>
EMAIL_FROM=Motion+ <noreply@yourdomain.com>

# Long random secret (at least 32 characters)
MAGIC_LINK_SECRET=replace-with-a-long-random-secret

# Your Vercel production URL
APP_URL=https://your-project.vercel.app
